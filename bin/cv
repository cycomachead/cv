#!/usr/bin/env ruby
# frozen_string_literal: true

# Tiny CLI for the dual-publishing system. Usage:
#   bin/cv site                       — build HTML site to build/site/
#   bin/cv pubs:tex [output]          — render publications LaTeX from YAML
#   bin/cv dblp [url]                 — fetch DBLP bibtex into dblp.bib

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'cv'

cmd = ARGV.shift || 'site'

case cmd
when 'site'
  out = CV::Site.new.build
  puts "wrote #{out.glob('*').count} files to #{out}"
when 'pubs:tex'
  output = ARGV.shift || (CV::BUILD_DIR.join('publications.tex'))
  data = CV::Data.load
  bib  = CV::Bib.load
  renderer = CV::Renderer.new(format: :latex)
  section = { 'title' => 'Writing & Publications' }
  rendered = renderer.render('publications.tex',
                             data: data, bib: bib,
                             locals: { section: section })
  require 'fileutils'
  FileUtils.mkdir_p(File.dirname(output))
  File.write(output, rendered)
  puts "wrote #{output}"
when 'dblp'
  url = ARGV.shift || CV::DBLP::DEFAULT_URL
  out = CV::DBLP.fetch(url: url)
  puts "wrote #{out}"
when 'help', '-h', '--help'
  puts <<~USAGE
    Usage: bin/cv <command>
      site              Build the HTML site (build/site/)
      pubs:tex [path]   Render publications.tex from YAML + bib
      dblp [url]        Refresh dblp.bib from DBLP
  USAGE
else
  warn "Unknown command: #{cmd}"
  exit 1
end
