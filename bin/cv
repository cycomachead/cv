#!/usr/bin/env ruby
# frozen_string_literal: true

# Tiny CLI for the dual-publishing system. Usage:
#   bin/cv md            — render YAML+bib to build/cv.md
#   bin/cv preview       — render md and convert to a standalone HTML preview
#   bin/cv pubs:tex [out] — render a publications LaTeX fragment

$LOAD_PATH.unshift File.expand_path('../lib', __dir__)
require 'cv'

cmd = ARGV.shift || 'md'

case cmd
when 'md', 'markdown'
  out = CV::Markdown.build
  puts "wrote #{out}"
when 'preview'
  CV::Markdown.build
  out = CV::Preview.build
  puts "wrote #{out}"
when 'tex'
  out = CV::Latex.build
  puts "wrote #{out}"
when 'pubs:tex'
  output = ARGV.shift || (CV::BUILD_DIR.join('publications.tex'))
  data = CV::Data.load
  bib  = CV::Bib.load
  rendered = CV::Renderer.new(format: :latex)
                         .render('publications.tex',
                                 data: data, bib: bib,
                                 locals: { section: { 'title' => 'Writing & Publications' } })
  require 'fileutils'
  FileUtils.mkdir_p(File.dirname(output))
  File.write(output, rendered)
  puts "wrote #{output}"
when 'help', '-h', '--help'
  puts <<~USAGE
    Usage: bin/cv <command>
      md                Build the canonical Markdown CV (build/cv.md)
      preview           Build cv.md and a standalone HTML preview (build/cv.html)
      tex               Render the full single-file LaTeX CV (build/cv.tex)
      pubs:tex [path]   Render only the publications LaTeX fragment

    To refresh dblp.bib from DBLP, use `make dblp` (curl one-liner).
  USAGE
else
  warn "Unknown command: #{cmd}"
  exit 1
end
