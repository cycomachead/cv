<section class="cv__section" id="press">
  <h2><%= h(section['title']) %></h2>
  <ol class="cv__entries">
    <% data.press.each do |item| -%>
      <li class="cv__entry">
        <strong><%= h(item['outlet']) %>:</strong> <%= h(item['title']) %>
        <% if item['date'] -%> · <%= h(item['date']) %><% end -%>
        <% if item['url'] -%>
          <div class="cv__entry-meta"><a href="<%= item['url'] %>"><%= item['url'] %></a></div>
        <% end -%>
      </li>
    <% end -%>
  </ol>
</section>
