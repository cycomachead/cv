<section class="cv__section" id="positions">
  <h2><%= h(section['title']) %></h2>
  <ol class="cv__entries">
    <% data.positions.each do |p| -%>
      <li class="cv__entry">
        <div class="cv__entry-head">
          <span class="cv__entry-when"><%= h(p['when']) %></span>
          <span class="cv__entry-what"><%= h(p['role']) %></span>
        </div>
        <div class="cv__entry-where"><%= h(p['employer']) %><% if p['location'] %>, <%= h(p['location']) %><% end %></div>
        <% if p['summary'] -%>
          <p class="cv__entry-summary"><%= h(p['summary']) %></p>
        <% end -%>
        <% if Array(p['highlights']).any? -%>
          <ul class="cv__bullets">
            <% p['highlights'].each do |hl| -%>
              <li><%= h(hl) %></li>
            <% end -%>
          </ul>
        <% end -%>
      </li>
    <% end -%>
  </ol>
</section>
