<header class="cv__header">
  <h1 class="cv__name"><%= h(data.basics['name']) %></h1>
  <p class="cv__title"><%= h(data.basics['title']) %></p>
  <ul class="cv__contact">
    <% if data.basics['address'] -%>
      <li><%= h(data.basics['address']) %></li>
    <% end -%>
    <% if data.basics['email'] -%>
      <li><a href="mailto:<%= data.basics['email'] %>"><%= data.basics['email'] %></a></li>
    <% end -%>
    <% if data.basics['homepage'] -%>
      <li><a href="<%= data.basics['homepage'] %>"><%= data.basics['homepage'].sub(%r{^https?://}, '') %></a></li>
    <% end -%>
    <% Array(data.basics['profiles']).each do |p| -%>
      <li><a href="<%= p['url'] %>"><%= h(p['label']) %></a></li>
    <% end -%>
  </ul>
</header>
