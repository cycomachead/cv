<section class="cv__section" id="teaching">
  <h2><%= h(section['title']) %></h2>

  <h3>Course Descriptions</h3>
  <dl class="cv__definitions">
    <% data.teaching['courses'].each do |c| -%>
      <dt><%= h(c['code']) %><% if c['units'] %> <span class="cv__units">(<%= h(c['units']) %> units)</span><% end %></dt>
      <dd><strong><%= h(c['title']) %></strong> — <%= h(c['description']) %></dd>
    <% end -%>
  </dl>

  <h3>Teaching Assignments</h3>
  <% if Array(data.teaching['notes']).any? -%>
    <ul class="cv__notes">
      <% data.teaching['notes'].each do |n| -%>
        <li><%= h(n) %></li>
      <% end -%>
    </ul>
  <% end -%>
  <ol class="cv__entries cv__entries--compact">
    <% data.teaching['assignments'].each do |a| -%>
      <li class="cv__entry">
        <span class="cv__entry-when"><%= h(a['term']) %></span>
        <span class="cv__entry-what"><%= h(a['detail']) %></span>
      </li>
    <% end -%>
  </ol>
</section>
