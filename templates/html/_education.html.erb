<section class="cv__section" id="education">
  <h2><%= h(section['title']) %></h2>
  <ol class="cv__entries">
    <% data.education.each do |e| -%>
      <li class="cv__entry">
        <div class="cv__entry-head">
          <span class="cv__entry-when"><%= h(e['when']) %></span>
          <span class="cv__entry-what"><%= h(e['degree']) %></span>
        </div>
        <div class="cv__entry-where"><%= h(e['institution']) %><% if e['location'] %>, <%= h(e['location']) %><% end %></div>
        <% if e['advisor'] -%>
          <div class="cv__entry-meta">Advisor: <%= h(e['advisor']) %></div>
        <% end -%>
        <% if e['thesis'] -%>
          <div class="cv__entry-meta">Thesis: <em><%= h(e['thesis']) %></em></div>
        <% end -%>
      </li>
    <% end -%>
  </ol>
</section>
