<section class="cv__section" id="publications">
  <h2><%= h(section['title']) %></h2>
  <% data.publications.each do |group| -%>
    <h3 id="<%= group['id'] %>"><%= h(group['heading']) %></h3>
    <ol class="cv__publications<%= ' cv__publications--reverse' if group['reverse'] %>">
      <% group['items'].each do |item| -%>
        <li class="cv__publication">
          <%= partial('_publication_item', item: item, group: group) %>
        </li>
      <% end -%>
    </ol>
  <% end -%>
</section>
