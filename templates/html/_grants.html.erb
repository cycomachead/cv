<section class="cv__section" id="grants">
  <h2><%= h(section['title']) %></h2>
  <ol class="cv__entries">
    <% data.grants.each do |g| -%>
      <li class="cv__entry">
        <div class="cv__entry-head">
          <span class="cv__entry-when"><%= h(g['when']) %></span>
          <span class="cv__entry-what"><strong><%= h(g['title']) %></strong></span>
        </div>
        <% if g['amount'] || g['role'] -%>
          <div class="cv__entry-where">
            <% if g['amount'] %><%= h(g['amount']) %><% end -%>
            <% if g['role']   %><% if g['amount'] %> · <% end %><%= h(g['role']) %><% end -%>
          </div>
        <% end -%>
        <% if g['summary'] -%>
          <p class="cv__entry-summary"><%= h(g['summary']) %></p>
        <% end -%>
      </li>
    <% end -%>
  </ol>
</section>
