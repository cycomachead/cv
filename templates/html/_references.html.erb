<section class="cv__section" id="references">
  <h2><%= h(section['title']) %></h2>
  <ul class="cv__references">
    <% data.references.each do |r| -%>
      <li>
        <strong><%= h(r['name']) %></strong>
        <% if r['title'] %><br><%= h(r['title']) %><% end -%>
        <% if r['email'] %><br><a href="mailto:<%= r['email'] %>"><%= r['email'] %></a><% end -%>
        <% if r['phone'] %><br><%= h(r['phone']) %><% end -%>
      </li>
    <% end -%>
  </ul>
</section>
