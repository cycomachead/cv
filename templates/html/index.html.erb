<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= h(data.basics['name']) %> — <%= h(data.basics['title']) %></title>
  <meta name="description" content="<%= h(data.basics['title']) %> — <%= h(data.basics['name']) %>">
  <link rel="stylesheet" href="assets/style.css">
</head>
<body>
<main class="cv">
  <%= partial('_header') %>

  <nav class="cv__alt">
    <a href="resume.html">One-page resume →</a>
  </nav>

  <% data.sections.each do |section| -%>
    <%= partial("_#{section['template']}", section: section) %>
  <% end -%>

  <footer class="cv__footer">
    <p>Last updated <%= Time.now.strftime('%B %-d, %Y') %>. Source on
      <a href="https://github.com/cycomachead/cv">GitHub</a>.
      <a href="https://raw.githubusercontent.com/cycomachead/cv/pdfs/main.pdf">PDF</a> ·
      <a href="https://raw.githubusercontent.com/cycomachead/cv/pdfs/one-page-resume.pdf">1-page PDF</a>.
    </p>
  </footer>
</main>
</body>
</html>
