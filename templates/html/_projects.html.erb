<section class="cv__section" id="projects">
  <h2><%= h(section['title']) %></h2>
  <ol class="cv__entries">
    <% data.projects.each do |p| -%>
      <li class="cv__entry">
        <h3 class="cv__entry-what"><%= h(p['name']) %></h3>
        <p class="cv__entry-summary"><%= h(p['summary']) %></p>
        <% if p['url'] -%>
          <p class="cv__entry-meta"><a href="<%= p['url'] %>"><%= p['url'].sub(%r{^https?://}, '') %></a></p>
        <% end -%>
      </li>
    <% end -%>
  </ol>
</section>
