<section class="cv__section" id="awards">
  <h2><%= h(section['title']) %></h2>
  <ol class="cv__entries">
    <% data.awards.each do |a| -%>
      <li class="cv__entry">
        <div class="cv__entry-head">
          <span class="cv__entry-when"><%= h(a['when']) %></span>
          <span class="cv__entry-what"><strong><%= h(a['title']) %></strong></span>
        </div>
        <% if a['issuer'] -%>
          <div class="cv__entry-where"><%= h(a['issuer']) %></div>
        <% end -%>
        <% if a['summary'] -%>
          <p class="cv__entry-summary"><%= h(a['summary']) %></p>
        <% end -%>
        <% if a['url'] -%>
          <p class="cv__entry-meta"><a href="<%= a['url'] %>"><%= h(a['url']) %></a></p>
        <% end -%>
      </li>
    <% end -%>
  </ol>
</section>
