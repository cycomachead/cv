<%# This fragment can replace latex/6-publications-conferences.tex (or any one
    publication group) from data/publications.yml + personal.bib. To use,
    \input{} the resulting file from latex/main.tex instead of the hand-edited
    .tex. The hand-edited file is preserved as the source of truth until you
    opt in. %>
\section{<%= h(section['title'] || 'Writing & Publications') %>}
\vspace{6pt}

<% data.publications.each do |group| -%>
\subsection{<%= h(group['heading']) %>}
\vspace{5pt}
<% if group['reverse'] -%>
\begin{etaremune}
<% else -%>
\begin{itemize}
<% end -%>
    \setlength\itemsep{1em}
<% group['items'].each do |item| -%>
<%
  if item['text']
    body = h(item['text'])
  else
    if item['bib']
      entry = bib[item['bib']] or raise "Missing bib key: #{item['bib']}"
      authors_list = entry.authors
      title  = entry.title
      venue  = item['venue_override'] || entry['booktitle']
      url    = item['url'] || entry.url
      year   = entry.year
    else
      authors_list = Array(item['authors'])
      title  = item['title']
      venue  = item['venue']
      url    = item['url']
      year   = item['year']
    end

    body = +''
    # An author list ending in an initial ("… Malan, David J.") already
    # supplies the sentence period; don't print a second one.
    unless authors_list.empty?
      rendered_authors = authors(authors_list)
      rendered_authors += '.' unless rendered_authors.end_with?('.')
      body << "#{rendered_authors}\n    \\newline "
    end
    body << h(title)
    body << " (#{h(item['kind'])})" if item['kind']
    body << '.'
    # `date` is the precise "May 6–13, 2026" / "March 2024" string when we have
    # one; `year` is the fallback for entries recorded only to the year.
    when_ = item['date'] || year
    body << "\n    \\newline #{h(venue)}#{when_ ? ", #{h(when_)}" : ''}." if venue
    body << "\n    \\newline #{link(url, url)}" if url
  end
-%>
    \item{<%= body %>}
<% end -%>
<% if group['reverse'] -%>
\end{etaremune}
<% else -%>
\end{itemize}
<% end -%>

<% end -%>
