<%-
  # Publication item — one of:
  #   text:    free-form Markdown prose
  #   bib:     key from personal.bib
  #   inline:  authors + title + venue + url + year
  if item['text']
    out = h(item['text'])
  else
    if item['bib']
      entry  = bib[item['bib']] or raise "Missing bib key: #{item['bib']}"
      a, t   = entry.authors, entry.title
      venue  = item['venue_override'] || entry['booktitle']
      url    = item['url'] || entry.url
      year   = entry.year
    else
      a, t  = Array(item['authors']), item['title']
      venue = item['venue']
      url   = item['url']
      year  = item['year']
    end
    parts  = []
    parts << authors(a) unless a.empty?
    title_part = "_#{h(t)}_"
    title_part += " (#{h(item['kind'])})" if item['kind']
    parts << title_part
    # `date` is the precise "May 6–13, 2026" / "March 2024" string when we have
    # one; `year` is the fallback for entries recorded only to the year. An
    # entry with a date but no venue still gets to say when it happened.
    when_ = item['date'] || year
    dateline = [(h(venue) if venue), (h(when_) if when_)].compact.join(', ')
    parts << dateline unless dateline.empty?
    parts << link(url) if url
    # Each part is its own sentence. An author list ending in an initial
    # ("… Malan, David J.") already supplies the period, so don't add a
    # second one.
    out = parts.map { |part| part.end_with?('.') ? part : "#{part}." }.join(' ')
  end
-%>
<%= out %>
