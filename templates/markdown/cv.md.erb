<%# Note on italic syntax: this template uses `_..._` (underscore italic) for
    italics rather than `*..*`, because the Snap! macro emits `*!*` and we
    don't want to trip kramdown's nested-asterisk parsing.

    Note on the `{:.entry}` IAL: kramdown attaches the class to the
    preceding paragraph; preview.css and the deployed Jekyll layout target
    `.entry` to make role/title lines visually distinct from the body. -%>
<%# `page_header` covers the name + job title only. The Jekyll embed turns it
    off because the site layout renders its own <h1> and subtitle — but the
    contact line, profile links, and bio have no equivalent there, so they are
    emitted either way or the deployed CV loses them entirely. -%>
<%- show_header = defined?(page_header) ? page_header : true -%>
<%- if jekyll_front_matter -%>
---
layout: cv
title: <%= h(data.basics['name']) %>
subtitle: <%= h(data.basics['title']) %>
permalink: /cv/
---
<% end -%>
<%- if show_header -%>

# <%= h(data.basics['name']) %>

**<%= h(data.basics['title']) %>**
<%- end -%>

<%= [data.basics['address'], link("mailto:#{data.basics['email']}", data.basics['email']),
     link(data.basics['homepage'])
    ].compact.reject(&:empty?).join(' · ') %>
{:.contact}

<%= [*Array(data.basics['profiles']).map { |p| link(p['url'], p['label']) }
    ].compact.reject(&:empty?).join(' · ') %>
{:.contact}

<%- if data.basics['bio'] && data.basics['bio']['short'] %>
<%= data.basics['bio']['short'].strip %>
{:.bio}
<% end %>

---

## Education

<%- data.education.each do |e| -%>
<%- lines = ["**#{h(e['degree'])}** · #{e['when']}",
             [h(e['institution']), (h(e['location']) if e['location'])].compact.join(', ')]
    lines << "Advisor: #{h(e['advisor'])}" if e['advisor']
    lines << "Thesis: _#{h(e['thesis'])}_"  if e['thesis'] -%>
<%= lines.join("<br>\n") %>
{:.entry}

<% end -%>

## Positions

<%- data.positions.each do |p| -%>
<%= ["**#{h(p['role'])}** · #{p['when']}",
     [h(p['employer']), (h(p['location']) if p['location'])].compact.join(', ')].join("<br>\n") %>
{:.entry}
<%- if p['summary'] %>

<%= h(p['summary']) %>
<%- end -%>
<%- Array(p['highlights']).each do |hl| %>
- <%= h(hl) %>
<%- end %>

<% end -%>

## Research Interests

<%- data.research_interests.each do |r| -%>
**<%= h(r['title']) %>** — <%= h(r['description']) %>

<%- end -%>

## Teaching — UC Berkeley

### Course Descriptions

<%# Courses with a public site get the URL appended after the description. -%>
<%- data.teaching['courses'].each do |c| -%>
- **<%= h(c['code']) %>** — _<%= h(c['title']) %>_<% if c['units'] %> (<%= c['units'] %> <%= c['units'].to_s.strip == '1' ? 'unit' : 'units' %>)<% end %>. <%= h(c['description']) %><% if c['url'] %> <%= link(c['url']) %><% end %>
<%- end %>

### Teaching Assignments

<%# A leading `*` (the co-taught legend) would otherwise parse as a list
    bullet inside the blockquote and disappear — escape it for kramdown. -%>
<%- notes = Array(data.teaching['notes']).map { |n| h(n).sub(/\A\*/) { '\*' } } -%>
<%- unless notes.empty? -%>
> <%= notes.join("<br>\n> ") %>
<%- end %>

<%- data.teaching['assignments'].each do |a| -%>
- **<%= h(a['term']) %>** — <%= h(a['detail']) %>
<%- end %>

## Awards

<%- data.awards.each do |a| -%>
**<%= h(a['title']) %>** · <%= a['when'] %><%- if a['issuer'] %> · <%= h(a['issuer']) -%><% end %>
{:.entry}
<%- if a['summary'] %>

<%= h(a['summary']) %>
<%- end %>
<%- if a['url'] %>
<%= link(a['url']) %>
<%- end %>

<% end -%>

## Grants & Gifts

<%- data.grants.each do |g| -%>
<%= ["**#{h(g['title'])}** · #{g['when']}",
     [g['amount'], g['role']].compact.map { |s| h(s) }.join(' · ')].reject(&:empty?).join("<br>\n") %>
{:.entry}
<%- if g['summary'] %>

<%= h(g['summary']) %>
<%- end %>

<% end -%>

## Students Supervised

<%- data.students.each do |s| -%>
- **<%= h(s['name']) %>** · <%= s['when'] %><%- if s['title'] %> — _<%= h(s['title']) %>_<% end -%><%- if s['advising'] %> (<%= h(s['advising']) %>)<% end -%><%- if s['url'] %>. <%= link(s['url']) %><% end %>
<%- end %>

## Service

<%- data.service.each do |group| -%>
### <%= h(group['heading']) %>

<%- group['items'].each do |item| -%>
- **<%= h(item['when']) %>** — <%= h(item['detail']) %><%- if item['note'] -%> _(<%= h(item['note']) %>)_<%- end %>
<%- end %>

<% end -%>

## Writing & Publications

<%- data.publications.each do |group| -%>
### <%= h(group['heading']) %>

<%- if group['reverse'] -%>
<ol reversed start="<%= group['items'].size %>" markdown="block">
<%- group['items'].each do |item| -%>
<li markdown="span"><%= partial('_publication', item: item) %></li>
<%- end %>
</ol>
<%- else -%>
<%- group['items'].each_with_index do |item, idx| -%>
<%= idx + 1 %>. <%= partial('_publication', item: item) %>
<%- end %>
<%- end %>

<% end -%>

## Media & News

<%- data.press.each do |p| -%>
- **<%= h(p['outlet']) %>** — <%= h(p['title']) %><%- if p['date'] -%> · <%= h(p['date']) -%><% end -%><%- if p['url'] -%>. <%= link(p['url']) %><%- end %>
<%- end %>

## Academic & Open-Source Software

<%- data.projects.each do |p| -%>
**<%= h(p['name']) %>**
{:.entry}

<%= h(p['summary']) %>
<%- if p['url'] %>
<%= link(p['url']) %>
<%- end %>

<% end -%>

## Technical Skills

<%- data.skills.each do |s| -%>
- **<%= h(s['label']) %>** — <%= h(s['detail']) %>
<%- end %>

## References

<%# The Markdown output is the public web CV (mball.co/cv), so the referees'
    names, emails, and phone numbers never appear here — data/references.yml
    feeds only the LaTeX builds, where \refphone additionally strips the phone
    numbers from every PDF we publish. -%>
References available upon request.
{:.references-note}
